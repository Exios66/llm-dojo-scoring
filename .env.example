# llm-dojo-scoring — copy to .env (or export) to configure the Langfuse sink.
# The dojo pulls live traces (dojo-sync / langfuse_sync) and emits ScoreRecords
# to Langfuse via the Emitter's LangfuseSink. All values are env-resolved —
# nothing is hardcoded.

# Langfuse project credentials (cloud or self-hosted). The key pair routes to
# the project that owns the traces; LANGFUSE_BASE_URL and LANGFUSE_HOST are
# aliases (either is honored, BASE_URL wins).
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_PROJECT=llm-dojo
# LANGFUSE_ENVIRONMENT=production

# Release label on every observation (optional).
# LANGFUSE_RELEASE=llm-dojo-scoring@0.15.0

# Optional: point the package at an external settings YAML wholesale
# (field_scoring + cost_models + equivalences). When set to an existing file,
# configure_from_taxonomy() honors it over the repo taxonomy.
# LLM_DOJO_SCORING_CONFIG=config/environments/dojo-settings.yaml