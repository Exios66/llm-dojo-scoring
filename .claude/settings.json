{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(uv run --extra dev pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(ruff check:*)",
      "Bash(uvx ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(python scripts/release.py status:*)",
      "Bash(python scripts/release.py check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch --list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(python scripts/release.py cut:*)",
      "Bash(python scripts/release.py publish:*)",
      "Bash(python scripts/release.py edit:*)",
      "Bash(python scripts/release.py assets:*)",
      "Bash(dojo-sync:*)",
      "Bash(uv lock:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git tag -d:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git tag --delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_check.py\""
          }
        ]
      }
    ]
  }
}
